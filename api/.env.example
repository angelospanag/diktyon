# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_api_key_here

# ── Optional: Greek GEMI registry ────────────────────────────────────────────
# Register at https://opendata.businessportal.gr to obtain a key.
# Leave blank (or omit) to disable the ?country=gr endpoints.
# GEMI_API_KEY=your_gemi_key_here

# ── Optional (defaults shown) ─────────────────────────────────────────────────
PORT=8080
# Omit REDIS_URL entirely to use the built-in in-memory cache (fine for single-instance deploys).
# REDIS_URL=redis://localhost:6379
CACHE_TTL=24h

# Companies House allows 600 requests per 5 minutes (= 2 rps).
# Raise the burst only if you know what you're doing.
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
