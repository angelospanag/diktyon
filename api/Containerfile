# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.26.5-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux \
    go build -ldflags="-s -w" -trimpath \
    -o /diktyon ./cmd/api

# ── Final stage ───────────────────────────────────────────────────────────────
# distroless/static-debian13:nonroot — no shell, no package manager.
# ca-certificates and the nonroot user (uid 65532) are included by default.
FROM gcr.io/distroless/static-debian13:nonroot

COPY --from=builder /diktyon /diktyon

EXPOSE 8080

ENTRYPOINT ["/diktyon"]
